# ─── Backend Environment Variables (set these in Render dashboard) ───────────
# PORT is set automatically by Render — do NOT set it manually
# SPRING_DATASOURCE_URL: Use JDBC format for Render PostgreSQL, e.g.:
#   jdbc:postgresql://<host>/<db>?user=<user>&password=<pass>&sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chatspark
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JPA_DDL_AUTO=update
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971
JWT_EXPIRATION_MS=86400000
# ⚠️  ROTATE THIS KEY — the original was exposed in git history (commit f468474)
# Get a new key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY_HERE
# Add your Cloudflare Pages URL when deployed, e.g.:
# ALLOWED_ORIGINS=https://chatspark-frontend.pages.dev,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ─── Frontend Environment Variables (set in Cloudflare Pages dashboard) ──────
# Replace with your Render backend URL after deploying:
VITE_API_BASE_URL=https://your-backend.onrender.com/api
